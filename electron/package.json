{
  "name": "scriblr-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Scriblr -- spawns the local FastAPI backend and shows it in a native window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "cross-env SCRIBLR_FORCE_PROD=1 electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.scriblr.app",
    "productName": "Scriblr",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/scriblr-backend.exe",
        "to": "backend/scriblr-backend.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../backend/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
