{
  "name": "scriblr-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Scriblr -- spawns the local FastAPI backend and shows it in a native window.",
  "author": "Scriblr",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "cross-env SCRIBLR_FORCE_PROD=1 electron .",
    "dist": "electron-builder",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.49.1"
  },
  "build": {
    "appId": "com.scriblr.app",
    "productName": "Scriblr",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/scriblr-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../backend/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
